# Copy to .env.phase2 (git-ignored), fill locally, then source with `set -a`.
# ADDRESSES AND SERVICE CREDENTIALS ONLY. Never put a wallet private key in this file.

DEPLOYER_ACCOUNT=poh-testnet-deployer
ISSUER_ACCOUNT=poh-testnet-issuer

# Optional paths for non-interactive commands. Files must be mode 0600 and outside the repository.
# Never place passwords themselves in this env file.
DEPLOYER_PASSWORD_FILE=
ISSUER_PASSWORD_FILE=

# Public addresses. The issuer address must belong to ISSUER_ACCOUNT.
POH_ISSUER=
POH_OWNER=
DEPLOY_PREDICATE=true

# Use provider endpoints appropriate for deployment traffic. Do not paste them into chat/logs.
BASE_SEPOLIA_RPC_URL=
ETHEREUM_SEPOLIA_RPC_URL=
CELO_SEPOLIA_RPC_URL=
ROBINHOOD_TESTNET_RPC_URL=
WORLDCHAIN_TESTNET_RPC_URL=

# Etherscan V2 verification for Base, Ethereum, Celo, and World Chain Sepolia.
# Robinhood verification uses its Blockscout endpoint and does not require this value.
ETHERSCAN_API_KEY=

# --- Optional v2 issuance rehearsal (one canonical testnet first) ---
# Public identifiers only. Keep the separate verification-authority private key
# in the web app's server secret manager, never in this deployment env file.
ZK_ISSUER_KEY_ID=
ZK_SELF_VERIFICATION_AUTHORITY=
ZK_SELF_CONFIG_ID=
ZK_ISSUANCE_OWNER=
