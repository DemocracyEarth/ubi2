# Public Base Sepolia staging target. Do not add a mainnet chain id.
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
POH_SPONSOR_TESTNET_CHAIN_IDS=84532

# Inject POH_SPONSOR_PRIVATE_KEY at runtime from a secret manager. Never commit it,
# expose it as NEXT_PUBLIC_*, put it in an image layer, or print the environment.
POH_SPONSOR_MAX_GAS=350000
POH_SPONSOR_MAX_FEE_WEI=500000000000000
POH_SPONSOR_MIN_RESERVE_WEI=1000000000000000
POH_SPONSOR_CONFIRMATIONS=1
POH_SPONSOR_RECEIPT_TIMEOUT_MS=90000
POH_SPONSOR_DAILY_TX_LIMIT=10

# Read-only monitor. Its state file contains only public chain telemetry.
POH_SPONSOR_MONITOR_CHAIN_ID=84532
POH_SPONSOR_MONITOR_ADDRESS=0x912Ea311b4dCF8D3663C8C125Dc1Ca896519252E
POH_SPONSOR_MONITOR_STATE_FILE=/var/lib/ubi2/poh-sponsor-monitor.json
POH_SPONSOR_MONITOR_START_BLOCK=45964967
POH_SPONSOR_MONITOR_MIN_RESERVE_WEI=1000000000000000
POH_SPONSOR_MONITOR_MAX_BALANCE_WEI=5000000000000000
POH_SPONSOR_MONITOR_DAILY_SPEND_LIMIT_WEI=500000000000000
POH_SPONSOR_MONITOR_MAX_BLOCKS=500
