# proofofhumanity.org — environment. Copy to .env.local for dev; set these in your host for prod.
# See DEPLOY.md for the full matrix. NEXT_PUBLIC_* are exposed to the browser; the rest are server-only.

# --- Server-only (NEVER prefix with NEXT_PUBLIC_) ---
# Voucher/attestation signer. Its address MUST equal ProofOfHumanity.issuer() on every live chain.
# Dev defaults to Anvil account #1 (not a secret). Production fails closed when this is missing.
# Store the production signer in an HSM/managed secret service; never use a deployer key here.
ISSUER_PRIVATE_KEY=

# Optional TESTNET-ONLY gas sponsor. Both values are required to enable it. Use a separate,
# low-balance hot account: never the issuer, deployer, contract owner, or a credential holder.
# Chain ids must be explicit configured public testnets; mainnet and local ids fail closed.
POH_SPONSOR_PRIVATE_KEY=
POH_SPONSOR_TESTNET_CHAIN_IDS=84532
# Hard transaction budget controls (defaults shown).
POH_SPONSOR_MAX_GAS=350000
POH_SPONSOR_MAX_FEE_WEI=5000000000000000
POH_SPONSOR_MIN_RESERVE_WEI=1000000000000000
POH_SPONSOR_CONFIRMATIONS=1
POH_SPONSOR_RECEIPT_TIMEOUT_MS=90000
POH_SPONSOR_DAILY_TX_LIMIT=100

# --- Site / SEO ---
# Canonical origin; drives absolute Open Graph / Twitter image URLs.
NEXT_PUBLIC_SITE_URL=https://proofofhumanity.org

# --- Self (self.xyz) ---
# Public HTTPS URL of /api/self-verify as the Self mobile app sees it (Self rejects localhost).
NEXT_PUBLIC_SELF_ENDPOINT=
# "staging" (mock passports) or "production" (real passports). Flips frontend + backend in lockstep.
NEXT_PUBLIC_SELF_ENV=staging

# --- Quick Launch contract pair (Base Sepolia only) ---
# Predicate issuance requires BOTH the PoH and PredicateVerifier address. The API checks on-chain
# that both contracts expose the same issuer address recovered from ISSUER_PRIVATE_KEY.
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=
NEXT_PUBLIC_BASE_SEPOLIA_POH=0x06BD253009F74ad934A4DaEac133b153d9Fe8029
NEXT_PUBLIC_BASE_SEPOLIA_PREDICATE=0x2051D33c2F10CDd3739324afc4C6fD957564a9D6
