# proofofhumanity.org — environment. Copy to .env.local for dev; set these in your host for prod.
# See DEPLOY.md for the full matrix. NEXT_PUBLIC_* are exposed to the browser; the rest are server-only.

# --- Server-only (NEVER prefix with NEXT_PUBLIC_) ---
# Voucher/attestation signer. Its address MUST equal ProofOfHumanity.issuer() on every live chain.
# Dev defaults to Anvil account #1 (not a secret). Production fails closed when this is missing.
# Store the production signer in an HSM/managed secret service; never use a deployer key here.
ISSUER_PRIVATE_KEY=

# --- Site / SEO ---
# Canonical origin; drives absolute Open Graph / Twitter image URLs.
NEXT_PUBLIC_SITE_URL=https://proofofhumanity.org

# --- Self (self.xyz) ---
# Public HTTPS URL of /api/self-verify as the Self mobile app sees it (Self rejects localhost).
NEXT_PUBLIC_SELF_ENDPOINT=
# "staging" (mock passports) or "production" (real passports). Flips frontend + backend in lockstep.
NEXT_PUBLIC_SELF_ENV=staging

# --- Per-chain contract pairs (zero ⇒ disabled; empty keeps any checked-in testnet default) ---
# Predicate issuance requires BOTH the PoH and PredicateVerifier address. The API checks on-chain
# that both contracts expose the same issuer address recovered from ISSUER_PRIVATE_KEY.
NEXT_PUBLIC_ETHEREUM_RPC_URL=
NEXT_PUBLIC_ETHEREUM_POH=
NEXT_PUBLIC_ETHEREUM_PREDICATE=
NEXT_PUBLIC_BASE_RPC_URL=
NEXT_PUBLIC_BASE_POH=
NEXT_PUBLIC_BASE_PREDICATE=
NEXT_PUBLIC_OP_RPC_URL=
NEXT_PUBLIC_OP_POH=
NEXT_PUBLIC_OP_PREDICATE=
NEXT_PUBLIC_CELO_RPC_URL=
NEXT_PUBLIC_CELO_POH=
NEXT_PUBLIC_CELO_PREDICATE=
NEXT_PUBLIC_WORLD_RPC_URL=
NEXT_PUBLIC_WORLD_POH=
NEXT_PUBLIC_WORLD_PREDICATE=
NEXT_PUBLIC_ROBINHOOD_RPC_URL=
NEXT_PUBLIC_ROBINHOOD_POH=
NEXT_PUBLIC_ROBINHOOD_PREDICATE=

# --- Testnet contract pairs (configure before mainnet) ---
NEXT_PUBLIC_ETHEREUM_SEPOLIA_RPC_URL=
NEXT_PUBLIC_ETHEREUM_SEPOLIA_POH=0x9538c846ac749444729EaE41599AB7A26683f347
NEXT_PUBLIC_ETHEREUM_SEPOLIA_PREDICATE=0x3AAC42302aB365b8D0af2EE0a2f44aDEF3E2796B
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=
NEXT_PUBLIC_BASE_SEPOLIA_POH=0x06BD253009F74ad934A4DaEac133b153d9Fe8029
NEXT_PUBLIC_BASE_SEPOLIA_PREDICATE=0x2051D33c2F10CDd3739324afc4C6fD957564a9D6
NEXT_PUBLIC_CELO_SEPOLIA_RPC_URL=
NEXT_PUBLIC_CELO_SEPOLIA_POH=
NEXT_PUBLIC_CELO_SEPOLIA_PREDICATE=
NEXT_PUBLIC_WORLD_SEPOLIA_RPC_URL=
NEXT_PUBLIC_WORLD_SEPOLIA_POH=
NEXT_PUBLIC_WORLD_SEPOLIA_PREDICATE=
NEXT_PUBLIC_ROBINHOOD_TESTNET_RPC_URL=
NEXT_PUBLIC_ROBINHOOD_TESTNET_POH=0xb0317d3481a2A78959b51C4D5DCE3f4991e50E12
NEXT_PUBLIC_ROBINHOOD_TESTNET_PREDICATE=0x4A1a892552B284eeDa540ECF3E3e44797a9D307e

# --- Local dev chain (Anvil) — drop in production ---
NEXT_PUBLIC_LOCAL_CHAIN_ID=31337
NEXT_PUBLIC_LOCAL_CHAIN_NAME=Anvil (local)
NEXT_PUBLIC_LOCAL_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_LOCAL_POH=
NEXT_PUBLIC_LOCAL_PREDICATE=
