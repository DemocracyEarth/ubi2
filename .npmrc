# Install a flat, npm-style node_modules (real directories, not symlinks into the
# .pnpm virtual store). Required so AWS Amplify's Next.js SSR compute bundler can find
# the `next` runtime dependency for apps/proofofhumanity in this pnpm monorepo.
# See: https://github.com/aws-amplify/amplify-hosting/blob/main/FAQ.md#support-for-monorepo-framework
node-linker=hoisted
